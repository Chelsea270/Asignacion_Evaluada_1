<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="540.0" prefWidth="600.0" style="-fx-background-color: #E6E6FA;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.test.asignacion1.controller.RegistroEstudiantesController">
   <children>
      <Label layoutX="59.0" layoutY="14.0" text="Registro de Estudiantes">
         <font>
            <Font name="System Bold Italic" size="14.0" />
         </font></Label>
      <Label layoutX="59.0" layoutY="38.0" text="Complete todos los campos para guardar" />
      <Separator layoutY="71.0" prefHeight="0.0" prefWidth="600.0" />
      <GridPane fx:id="grdDatos" layoutX="39.0" layoutY="73.0" prefHeight="152.0" prefWidth="482.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="263.0" minWidth="10.0" prefWidth="197.4" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="352.4" minWidth="10.0" prefWidth="341.4" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Carnet:" />
            <Label text="Nombres:" GridPane.rowIndex="1" />
            <Label text="Apellidos:" GridPane.rowIndex="2" />
            <Label text="Carrera:" GridPane.rowIndex="3" />
            <Label text="Correo:" GridPane.rowIndex="4" />
            <TextField fx:id="txtCarnet" promptText="Ingrese el carnet del estudiante" GridPane.columnIndex="1" />
            <TextField fx:id="txtNombres" promptText="Ingrese los nombres " GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="txtApellidos" promptText="Ingrese los apellidos" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="txtCarrera" promptText="Ingrese la carrera" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField fx:id="txtCorreo" promptText="Ingrese el correo electronico" GridPane.columnIndex="1" GridPane.rowIndex="4" />
         </children>
      </GridPane>
      <Button fx:id="btnGuardar" layoutX="256.0" layoutY="238.0" mnemonicParsing="false" onAction="#guardarEstudiante" style="-fx-background-color: #B0C4DE;" text="Guardar">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font></Button>
      <Button fx:id="btnLimpiar" layoutX="328.0" layoutY="238.0" mnemonicParsing="false" onAction="#limpiarCampos" style="-fx-background-color: #B0C4DE;" text="Limpiar">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font></Button>
      <Button fx:id="btnInformacion" layoutX="393.0" layoutY="238.0" mnemonicParsing="false" onAction="#mostrarInformacion" style="-fx-background-color: #B0C4DE;" text="Información">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font></Button>
      <Label layoutX="45.0" layoutY="270.0" text="Estudiantes registrados">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font></Label>
      <TextArea fx:id="txtAreaEstudiantes" editable="false" layoutX="45.0" layoutY="300.0" prefHeight="186.0" prefWidth="529.0" />
   </children>
</AnchorPane>
